{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mesh-landing",
	"compatibility_date": "2026-09-17",
	"assets": {
		"directory": "build",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"pattern": "mesh.asy.web.id",
			"custom_domain": true
		}
	],
	"workers_dev": false
}
